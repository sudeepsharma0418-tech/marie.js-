# Copy this file to .env and fill in the values.

# Postgres connection string. Get a free one at https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign login cookies.
# Make one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Optional. Which Claude model the companions use.
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Optional. How hard the model thinks: low (default, fast and cheap), medium or high.
# ANTHROPIC_EFFORT="low"

# Optional. Per user message limits.
# CHAT_LIMIT_PER_MINUTE=15
# CHAT_LIMIT_PER_DAY=400
