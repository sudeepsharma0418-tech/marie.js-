{
  "name": "hotelproc",
  "private": true,
  "version": "0.1.0",
  "description": "Hotel procurement, supply chain, inventory and financial management platform (Butwal, Nepal)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @hp/api dev",
    "dev:web": "pnpm --filter @hp/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @hp/api db:generate",
    "db:migrate": "pnpm --filter @hp/api db:migrate",
    "db:seed": "pnpm --filter @hp/api db:seed",
    "db:reset": "pnpm --filter @hp/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "type": "module"
}
