# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL 16+. Use separate databases for development, testing and production.
DATABASE_URL=postgresql://hp:change-me@localhost:5432/hotelproc_dev
# Used only by the API test suite. It is wiped on every test run.
TEST_DATABASE_URL=postgresql://hp:change-me@localhost:5432/hotelproc_test

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts MFA secrets. Losing it means every user must re-enrol MFA.
APP_ENCRYPTION_KEY=

# Public origin of the web app (used in invitation and reset links).
WEB_ORIGIN=http://localhost:5173
# Must be true in production (HTTPS only cookies).
COOKIE_SECURE=false
# true when running behind a reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=false

# Uploaded files (contracts, delivery photos, bills). Use a persistent, backed-up volume.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
LOG_LEVEL=info

# Production single-process mode: serve the built web app from the API.
# WEB_DIST_DIR=../web/dist
